{
  "name": "truden",
  "version": "0.1.0",
  "description": "Hold Alt and shake the mouse anywhere in your web app to capture and snip UI for AI assistants.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "push": "tsup && yalc push"
  },
  "keywords": [
    "screenshot",
    "snip",
    "screen-capture",
    "ai-assistant",
    "copilot",
    "vision-llm",
    "html2canvas"
  ],
  "author": "Francis Igwe",
  "license": "MIT",
  "dependencies": {
    "html2canvas": "1.4.1"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
